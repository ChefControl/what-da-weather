# Copy to .env to override defaults. Everything works out of the box without a .env file.

# GGUF model downloaded by llama.cpp on first start (cached in the llm-models volume).
# See DESIGN.md D7 for the shortlist. Swap both values to change models — no rebuild
# needed (the FILE name keys the cache, so a new model never reuses a stale download).
LLM_MODEL_URL=https://huggingface.co/Qwen/Qwen2.5-3B-Instruct-GGUF/resolve/main/qwen2.5-3b-instruct-q4_k_m.gguf
LLM_MODEL_FILE=qwen2.5-3b-instruct-q4_k_m.gguf

# RabbitMQ credentials (the default "guest" user is localhost-only, so we create our own)
RABBITMQ_USER=weather
RABBITMQ_PASS=weather

# Host ports
APP_PORT=8080
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
RABBITMQ_MGMT_PORT=15672
